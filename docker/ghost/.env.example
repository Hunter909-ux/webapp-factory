# Local Ghost development — PLACEHOLDERS ONLY. Copy to .env (gitignored).
# MySQL root password for the local container (pick any local-only value)
MYSQL_ROOT_PASSWORD=change-me-local-only
# Public URL Ghost thinks it runs on (local dev)
GHOST_URL=http://localhost:2368
# Which database this Ghost instance uses: ghost_muscar or ghost_pwh
GHOST_DATABASE=ghost_muscar
