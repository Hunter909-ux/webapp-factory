---
/**
 * Inline wordmark logo for patchworkheroes.de.
 * Uses currentColor so it inherits the surrounding text colour in both
 * light and dark modes.
 */
interface Props {
  /** Accessible label for the logo link. */
  label?: string;
}

const { label = "Patchwork Heroes" } = Astro.props;
const homeHref = Astro.url.pathname.startsWith("/en") ? "/en/" : "/";
---

<a href={homeHref} aria-label={label} class="inline-block">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 220 40"
    width="180"
    height="33"
    role="img"
    aria-label={label}
    class="h-8 w-auto"
  >
    <text
      x="0"
      y="30"
      font-family="var(--font-heading, 'DM Serif Display', Georgia, serif)"
      font-size="28"
      fill="currentColor"
      letter-spacing="-0.02em"
    >
      patchworkheroes
    </text>
  </svg>
</a>
