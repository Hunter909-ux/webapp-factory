---
import { getEntry } from "astro:content";
/**
 * Datenschutz — DSGVO compliant legal page, excluded from search engines.
 */
import SEOHead from "@webapp-factory/shared/components/SEOHead.astro";
import Landing from "../layouts/Landing.astro";

const entry = await getEntry("legal", "datenschutz");
if (!entry) {
  throw new Error("Legal entry 'datenschutz' not found");
}
const { Content } = await entry.render();
const canonical = `${Astro.site?.toString() ?? "https://patchworkheroes.de"}datenschutz/`;
---

<Landing title={entry.data.title} description={entry.data.description} lang="de">
  <SEOHead
    slot="head"
    title={entry.data.title}
    description={entry.data.description ?? ""}
    canonical={canonical}
    noindex
  />
  <div class="prose mx-auto py-12">
    <Content />
  </div>
</Landing>
