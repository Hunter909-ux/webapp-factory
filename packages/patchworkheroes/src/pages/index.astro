---
/**
 * DE landing page (default locale) — structural placeholder.
 * Agent 3 fills the real sections in Issue #24.
 */
import { createOrganizationSchema, createWebSiteSchema } from "@webapp-factory/shared/seo";
import Landing from "../layouts/Landing.astro";

const siteUrl = "https://patchworkheroes.de";
const schema = [
  createWebSiteSchema({
    name: "Patchwork Heroes",
    url: siteUrl,
    description: "Klarheit, Stärke und praktische Tools für Patchworkfamilien.",
  }),
  createOrganizationSchema({ name: "Patchwork Heroes", url: siteUrl }),
];
---

<Landing title="Patchwork Heroes" description="patchworkheroes.de — bald verfügbar" lang="de" schema={schema}>
  <section class="flex min-h-screen items-center justify-center">
    <h1 class="text-4xl">Patchwork Heroes</h1>
  </section>
</Landing>
