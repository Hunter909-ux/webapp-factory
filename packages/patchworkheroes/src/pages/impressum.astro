---
/**
 * Impressum — § 5 TMG compliant legal page, excluded from search engines.
 */
import { getEntry } from "astro:content";
import Landing from "../layouts/Landing.astro";

const entry = await getEntry("legal", "impressum");
if (!entry) {
  throw new Error("Legal entry 'impressum' not found");
}
const { Content } = await entry.render();
---

<Landing title={entry.data.title} description={entry.data.description} lang="de" noindex>
  <div class="prose mx-auto py-12">
    <Content />
  </div>
</Landing>
