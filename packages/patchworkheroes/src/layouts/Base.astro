---
/**
 * Base layout — HTML shell shared by every page.
 * Title, description and SEO tags are handled by the SEOHead component
 * inside the "head" slot (via Landing/Blog layouts).
 */
import "../styles/base.css";

interface Props {
  /** BCP-47 language of the page content. */
  lang?: string;
}

const { lang = "de" } = Astro.props;
/** patchworkheroes.de defaults to light mode. */
const defaultTheme = "light";
---

<!doctype html>
<html lang={lang} data-theme={defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Self-hosted font preloads (Issue #10) -->
    <link rel="preload" href="/fonts/dm-serif-display-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <script is:inline>
      // Apply the persisted theme before first paint to avoid a flash.
      const storedTheme = localStorage.getItem("theme");
      if (storedTheme === "light" || storedTheme === "dark") {
        document.documentElement.dataset.theme = storedTheme;
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
