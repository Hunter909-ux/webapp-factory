---
/**
 * Landing layout — full-width sections, no sidebar.
 * Header/Footer come from the shared component library.
 */
import Footer from "@webapp-factory/shared/components/Footer.astro";
import Header from "@webapp-factory/shared/components/Header.astro";
import Base from "./Base.astro";

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description, lang = "en" } = Astro.props;

/** Language variants of the landing page (Issue #11 refines per-page links). */
const languages = [
  { code: "en", label: "EN", href: "/" },
  { code: "de", label: "DE", href: "/de/" },
];
---

<Base title={title} description={description} lang={lang}>
  <slot name="head" slot="head" />
  <Header languages={languages} currentLocale={lang}>
    <a slot="logo" href={lang === "de" ? "/de/" : "/"}>muscar.ai</a>
  </Header>
  <main class="w-full">
    <slot />
  </main>
  <Footer copyrightName="muscar.ai" />
</Base>
