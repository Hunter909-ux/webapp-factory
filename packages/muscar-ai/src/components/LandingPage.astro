---
/**
 * Shared landing page content for EN and DE.
 * Receives the locale and pulls the matching dictionary.
 */
import CTASection from "@webapp-factory/shared/components/CTASection.astro";
import Hero from "@webapp-factory/shared/components/Hero.astro";
import NewsletterForm from "@webapp-factory/shared/components/NewsletterForm.astro";
import ProblemSection from "@webapp-factory/shared/components/ProblemSection.astro";
import { useTranslations } from "@webapp-factory/shared/i18n";
import { createOrganizationSchema, createWebSiteSchema } from "@webapp-factory/shared/seo";
import { getDictionary } from "../i18n/index.js";
import Landing from "../layouts/Landing.astro";
import OpenSourceSection from "./OpenSourceSection.astro";
import SolutionSection from "./SolutionSection.astro";

interface Props {
  lang: "en" | "de";
}

const { lang } = Astro.props;
const t = useTranslations(getDictionary(lang));

const site = Astro.site?.toString() ?? "https://muscar.ai";
const siteName = "muscar.ai";
const description =
  lang === "de" ? "Open-Source-Tools für Systemdenker." : "Open-source tools for systems thinkers.";
const ogImage = new URL("/og-default.png", site).toString();

const schema = [
  createWebSiteSchema({ name: siteName, url: site, description }),
  createOrganizationSchema({
    name: siteName,
    url: site,
    logo: new URL("/logo.svg", site).toString(),
    sameAs: ["https://github.com/Hunter909-ux/webapp-factory"],
  }),
];

const ghostUrl = process.env.GHOST_URL ?? import.meta.env.GHOST_URL ?? "http://localhost:2368";
const newsletterAction = `${ghostUrl.replace(/\/$/, "")}/members/api/send-magic-link/`;

const painPoints = [
  { title: t("problem.pain1.title"), text: t("problem.pain1.text") },
  { title: t("problem.pain2.title"), text: t("problem.pain2.text") },
  { title: t("problem.pain3.title"), text: t("problem.pain3.text") },
];

const steps = [
  { title: t("solution.step1.title"), text: t("solution.step1.text") },
  { title: t("solution.step2.title"), text: t("solution.step2.text") },
  { title: t("solution.step3.title"), text: t("solution.step3.text") },
];
---

<Landing title={siteName} {description} {lang} {ogImage} {schema} copyrightName={`muscar.ai — ${t("footer.copyright")}`}>
  <!-- Hero -->
  <Hero headline={t("hero.headline")} subline={t("hero.subline")}>
    <div slot="cta" class="flex flex-wrap justify-center gap-4">
      <a
        href="#newsletter"
        class="rounded-md bg-[var(--color-primary)] px-5 py-3 text-[var(--color-text-on-primary)] transition-colors hover:bg-[var(--color-primary-hover)]"
      >
        {t("hero.ctaNewsletter")}
      </a>
      <a
        href="https://github.com/Hunter909-ux/webapp-factory"
        rel="noopener"
        target="_blank"
        class="rounded-md border border-[var(--color-border)] px-5 py-3 transition-colors hover:bg-[var(--color-bg-elevated)]"
      >
        {t("hero.ctaGitHub")}
      </a>
    </div>
    <img
      slot="visual"
      src="/symbol.svg"
      alt=""
      width="192"
      height="192"
      class="mt-8 h-48 w-48 opacity-90"
      loading="eager"
    />
  </Hero>

  <!-- Problem -->
  <ProblemSection heading={t("problem.heading")} painPoints={painPoints}>
    <svg slot="icon-1" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-4.41 0-8-3.59-8-8a10.07 10.07 0 0 1 2.06-5.94l2.12 2.12A6 6 0 0 0 12 16a6 6 0 0 0 3.82-1.76l2.12 2.12Z" />
      <line x1="2" y1="2" x2="22" y2="22" />
    </svg>
    <svg slot="icon-2" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.29-5.23" />
      <path d="M22 12.5a10 10 0 0 1-18.29 5.23" />
    </svg>
    <svg slot="icon-3" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z" />
      <path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z" />
    </svg>
  </ProblemSection>

  <!-- Solution -->
  <SolutionSection
    heading={t("solution.heading")}
    body={t("solution.body")}
    steps={steps}
  />

  <!-- Open Source -->
  <OpenSourceSection
    heading={t("openSource.heading")}
    body={t("openSource.body")}
    ctaStar={t("openSource.ctaStar")}
    ctaDocs={t("openSource.ctaDocs")}
    githubUrl="https://github.com/Hunter909-ux/webapp-factory"
    docsUrl="https://github.com/Hunter909-ux/webapp-factory#readme"
  />

  <!-- Newsletter -->
  <CTASection heading={t("newsletter.heading")} subline={t("newsletter.subline")}>
    <div id="newsletter" class="mx-auto w-full max-w-md pt-4">
      <NewsletterForm
        action={newsletterAction}
        placeholder={t("newsletter.placeholder")}
        buttonLabel={t("newsletter.submit")}
        successMessage={t("newsletter.success")}
        errorMessage={t("newsletter.error")}
      />
    </div>
  </CTASection>
</Landing>
