---
/**
 * FAQSection — renders visible FAQ markup plus FAQPage JSON-LD for AEO.
 * The schema object is returned in the `schema` prop so pages can pass it
 * to the SEOHead component.
 */
export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  heading?: string;
  items: FAQItem[];
}

const { heading = "Frequently Asked Questions", items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="mx-auto max-w-3xl px-4 py-12">
      <h2 class="mb-8 text-2xl">{heading}</h2>
      <dl class="flex flex-col gap-6">
        {items.map((item) => (
          <div class="rounded-lg border border-[var(--color-border)] p-5">
            <dt class="mb-2 font-bold">{item.question}</dt>
            <dd class="text-[var(--color-text-secondary)]">{item.answer}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}
