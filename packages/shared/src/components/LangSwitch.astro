---
/**
 * LangSwitch — links to the language variant of the current page.
 * Pure links (no JS): search engines can follow them.
 */

/** One selectable language. */
interface Language {
  code: string;
  label: string;
  href: string;
}

interface Props {
  languages: Language[];
  current: string;
}

const { languages, current } = Astro.props;
---

<nav aria-label="Language selection" class="flex items-center gap-2">
  {
    languages.map((language) =>
      language.code === current ? (
        <span aria-current="true" class="font-bold">
          {language.label}
        </span>
      ) : (
        <a href={language.href} rel="alternate" hreflang={language.code}>
          {language.label}
        </a>
      ),
    )
  }
</nav>
