# ============================================================
# webapp-factory — environment variables (PLACEHOLDERS ONLY)
# Copy to .env and fill in real values. NEVER commit secrets.
# Real values live in Zeabur env vars or a local .env (gitignored).
# ============================================================

# --- Ghost CMS (per site instance) ---
# Internal or public URL of the Ghost instance
GHOST_URL=http://localhost:2368
# Ghost Content API key (read-only, public by design)
GHOST_CONTENT_KEY=your-content-api-key-here
# Ghost Admin API key (write access — keep secret!)
GHOST_ADMIN_KEY=your-admin-api-key-here

# --- Site (public values, exposed to the client) ---
PUBLIC_SITE_URL=https://example.com
PUBLIC_PLAUSIBLE_DOMAIN=example.com

# --- Mailerlite (patchworkheroes.de 7-day reset) ---
# Account ID from Mailerlite settings and the embedded form ID.
PUBLIC_MAILERLITE_ACCOUNT_ID=your-mailerlite-account-id
PUBLIC_MAILERLITE_FORM_ID=your-mailerlite-form-id
